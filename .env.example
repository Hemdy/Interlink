# Neon pooled connection string for application runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/interlink?sslmode=require"

# Neon direct connection string for migrations and administrative tooling.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/interlink?sslmode=require"

# Neon Object Storage (S3-compatible) credentials pulled by `neon deploy` / `neon env pull`
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
