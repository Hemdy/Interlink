{
  "name": "interlink",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@interlink/web",
    "dev:mobile": "pnpm --filter @interlink/mobile dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "turbo run db:generate --filter=@interlink/database",
    "db:migrate": "turbo run db:migrate --filter=@interlink/database",
    "db:studio": "turbo run db:studio --filter=@interlink/database",
    "db:seed": "turbo run db:seed --filter=@interlink/database"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.5",
    "dotenv-cli": "^8.0.0",
    "eslint": "^10.14.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3"
  }
}
